# ═══════════════════════════════════════════════════════════════════════════════
#  THREAT-SENSE AI — Environment Configuration
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="THREAT-SENSE AI"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# Development default (SQLite — no Docker needed)
DATABASE_URL=sqlite+aiosqlite:///./threatsense.db
# Production (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://threatsense:threatsense@postgres:5432/threatsense

# PostgreSQL container settings (used by docker-compose.yml)
POSTGRES_USER=threatsense
POSTGRES_PASSWORD=threatsense
POSTGRES_DB=threatsense

# ── NLP Engine ────────────────────────────────────────────────────────────────
# Options: rules | zeroshot | finetuned | ensemble
# 'rules'     — fully offline, deterministic lexicon/regex (default)
# 'zeroshot'  — pretrained NLI model; requires internet on first run (CPU-capable)
# 'finetuned' — DeBERTa fine-tuned model (not available until Stage 13)
# 'ensemble'  — rules + zeroshot combined with configurable weights
NLP_BACKEND=rules

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-openssl-rand-hex-32
API_KEY_HEADER=X-API-Key
# Leave empty to disable API-key auth in development
API_KEY=

# ── SafeFetcher ───────────────────────────────────────────────────────────────
SAFE_FETCHER_TIMEOUT_SECONDS=10
SAFE_FETCHER_MAX_BODY_BYTES=10485760   # 10 MB
SAFE_FETCHER_MAX_REDIRECTS=5
SAFE_FETCHER_USER_AGENT="ThreatSenseAI/0.1 (security-scanner; contact=admin@example.com)"
# Optional HTTP proxy (leave empty to disable)
SAFE_FETCHER_PROXY=

# ── Threat Intelligence Providers ─────────────────────────────────────────────
# All providers degrade gracefully when the key is absent (offline mode / local feeds).

# Google Safe Browsing — https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=

# PhishTank — https://www.phishtank.com/api_info.php (free registration)
PHISHTANK_API_KEY=

# URLhaus (no key required for read-only feed)
# URLHAUS_FEED_URL=https://urlhaus-api.abuse.ch/v1/

# ── Privacy ───────────────────────────────────────────────────────────────────
# Set to false to disable sending URLs/hashes to third-party intel providers
SEND_URLS_TO_THIRD_PARTIES=true

# ── Upload Hardening ──────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_BYTES=52428800   # 50 MB
UPLOAD_DIR=./uploads             # Must be outside the web root

# ── Redis (optional — needed for distributed rate-limiting and caching) ───────
REDIS_URL=redis://redis:6379/0
