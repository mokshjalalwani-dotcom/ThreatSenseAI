# Frontend environment variables
# Copy this to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ── Backend API URL ────────────────────────────────────────────────────────────
# Local development — points to the local uvicorn server
VITE_API_URL=http://127.0.0.1:8000

# Production — uncomment and set to your Render backend URL
# VITE_API_URL=https://threatsense-api.onrender.com
